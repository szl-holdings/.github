{
  "schema": "szl.holographic-space-theme-registry/v2",
  "version": "2.0.0",
  "principle": "One governed interaction fabric; a deterministic visual instrument for every Space.",
  "shared_contract": {
    "navigation": ["Command", "Proof", "Spaces", "Source"],
    "minimum_touch_target_px": 44,
    "viewports": [320, 360, 390, 768, 1024, 1440],
    "reduced_motion": true,
    "high_contrast": true,
    "forced_colors": true,
    "low_power_mode": true,
    "local_assets_only": true,
    "analytics": false,
    "storage": false,
    "runtime_fetch": false
  },
  "palette": {
    "system": "SZL KANCHAY v1.1.0, founder direction (szl-holdings/szl-brand kanchay/ @aa876fa, szl-design-system.css)",
    "ground": "--bg (color-space-900)",
    "surface": "--surface",
    "foreground": "--text",
    "muted": "--text-sub",
    "focus": "--focus (color-yuyay-400)",
    "linework": "color-silver-* for lines, fields, glows and dot fields",
    "accent": "one functional accent per family: teal (color-yuyay-200/300/400), or gold (--premium) for premium flagship families only",
    "coral": "not used: the fabric has no single node element",
    "excluded": "violet, purple, blue-violet and cyan gradients",
    "values": "literal token hex in szl-space-hologram.css and szl-space-hologram.js, because Spaces may not load szl-design-system.css",
    "identity": "the motif (geometry) differentiates each Space; palettes are nearly uniform by design"
  },
  "curated_families": {
    "a11oy": {"motif": "command-grid", "purpose": "governed command and orchestration", "accent": "premium (color-hatun-300)", "linework": "color-silver-300"},
    "lyte": {"motif": "signal-aurora", "purpose": "observability and signal intelligence", "accent": "color-yuyay-300", "linework": "color-silver-300"},
    "vessels": {"motif": "bathymetric-radar", "purpose": "maritime situational awareness", "accent": "color-yuyay-200", "linework": "color-silver-300"},
    "terra": {"motif": "parcel-topography", "purpose": "real-estate and land intelligence", "accent": "color-yuyay-300", "linework": "color-silver-100"},
    "aegis": {"motif": "threat-lattice", "purpose": "defense and security operations", "accent": "color-yuyay-400", "linework": "color-silver-300"},
    "prism-counsel": {"motif": "case-lines", "purpose": "legal matter command", "accent": "color-yuyay-200", "linework": "color-silver-100"},
    "carlota-jo": {"motif": "editorial-orbit", "purpose": "advisory coordination", "accent": "color-yuyay-200", "linework": "color-silver-300"},
    "nexus": {"motif": "graph-mesh", "purpose": "integration and ecosystem routing", "accent": "color-yuyay-300", "linework": "color-silver-100"},
    "a11oy-factory": {"motif": "build-circuit", "purpose": "governed artifact production", "accent": "premium (color-hatun-300)", "linework": "color-silver-300"},
    "ouroboros": {"motif": "recursive-weave", "purpose": "looped computation and research", "accent": "color-yuyay-400", "linework": "color-silver-100"},
    "killinchu": {"motif": "agent-swarm", "purpose": "multi-agent orchestration", "accent": "premium (color-hatun-300)", "linework": "color-silver-100"},
    "immune": {"motif": "cell-membrane", "purpose": "admission, verification, and resilience", "accent": "color-yuyay-300", "linework": "color-silver-300"},
    "governed-receipt-verifier": {"motif": "checksum-ledger", "purpose": "receipt verification", "accent": "color-yuyay-200", "linework": "color-silver-100"}
  },
  "unknown_space_policy": {
    "identity": "FNV-1a slug hash",
    "palette": "deterministically selected from the founder teal/silver pairs in szl-space-hologram.js (neutrals fixed, never gold or coral)",
    "motif": "deterministically selected from the registered geometry set",
    "reshuffle_between_deployments": false
  },
  "original_synthesis": [
    "editorial restraint and hierarchy",
    "cinematic orbital mission-control depth",
    "technical geometry and high-signal contrast",
    "telemetry and observability layers",
    "modular agent and cybersecurity cells",
    "premium spatial precision"
  ]
}
