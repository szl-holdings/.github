{
  "schema": "szl.holographic-space-theme-registry/v2",
  "version": "2.0.0",
  "principle": "One governed interaction fabric; a deterministic visual instrument for every Space.",
  "shared_contract": {
    "navigation": ["Command", "Proof", "Spaces", "Source"],
    "minimum_touch_target_px": 44,
    "viewports": [320, 360, 390, 768, 1024, 1440],
    "reduced_motion": true,
    "high_contrast": true,
    "forced_colors": true,
    "low_power_mode": true,
    "local_assets_only": true,
    "analytics": false,
    "storage": false,
    "runtime_fetch": false
  },
  "palette": {
    "system": "SZL Kanchay v1.0.0 (szl-holdings/szl-brand kanchay/tokens.json)",
    "ground": "color-a11oy-bg",
    "surface": "color-a11oy-surface",
    "foreground": "color-a11oy-text",
    "muted": "color-a11oy-text-sub",
    "focus": "color-focus",
    "accent_scales": ["color-hatun-*", "color-yuyay-*", "color-yawar-*"],
    "excluded": "violet, purple and blue-violet accents",
    "minimum_accent_contrast_on_ground": 6.4,
    "values": "literal token hex in szl-space-hologram.css and szl-space-hologram.js, because Spaces may not load kanchay.css",
    "identity": "every Space shares the ground roles; the motif (geometry) and the accent pair differentiate it"
  },
  "curated_families": {
    "a11oy": {"motif": "command-grid", "purpose": "governed command and orchestration", "accent": "color-hatun-300", "accent_2": "color-yuyay-300"},
    "lyte": {"motif": "signal-aurora", "purpose": "observability and signal intelligence", "accent": "color-yuyay-300", "accent_2": "color-hatun-300"},
    "vessels": {"motif": "bathymetric-radar", "purpose": "maritime situational awareness", "accent": "color-yuyay-200", "accent_2": "color-yuyay-400"},
    "terra": {"motif": "parcel-topography", "purpose": "real-estate and land intelligence", "accent": "color-hatun-400", "accent_2": "color-yuyay-200"},
    "aegis": {"motif": "threat-lattice", "purpose": "defense and security operations", "accent": "color-yawar-300", "accent_2": "color-hatun-300"},
    "prism-counsel": {"motif": "case-lines", "purpose": "legal matter command", "accent": "color-hatun-200", "accent_2": "color-yuyay-200"},
    "carlota-jo": {"motif": "editorial-orbit", "purpose": "advisory coordination", "accent": "color-yawar-200", "accent_2": "color-hatun-200"},
    "nexus": {"motif": "graph-mesh", "purpose": "integration and ecosystem routing", "accent": "color-yuyay-300", "accent_2": "color-hatun-200"},
    "a11oy-factory": {"motif": "build-circuit", "purpose": "governed artifact production", "accent": "color-hatun-200", "accent_2": "color-yuyay-400"},
    "ouroboros": {"motif": "recursive-weave", "purpose": "looped computation and research", "accent": "color-hatun-300", "accent_2": "color-yuyay-200"},
    "killinchu": {"motif": "agent-swarm", "purpose": "multi-agent orchestration", "accent": "color-yawar-200", "accent_2": "color-yuyay-300"},
    "immune": {"motif": "cell-membrane", "purpose": "admission, verification, and resilience", "accent": "color-yuyay-300", "accent_2": "color-yawar-300"},
    "governed-receipt-verifier": {"motif": "checksum-ledger", "purpose": "receipt verification", "accent": "color-yuyay-200", "accent_2": "color-hatun-300"}
  },
  "unknown_space_policy": {
    "identity": "FNV-1a slug hash",
    "palette": "deterministically selected from the Kanchay accent pairs in szl-space-hologram.js (ground roles fixed)",
    "motif": "deterministically selected from the registered geometry set",
    "reshuffle_between_deployments": false
  },
  "original_synthesis": [
    "editorial restraint and hierarchy",
    "cinematic orbital mission-control depth",
    "technical geometry and high-signal contrast",
    "telemetry and observability layers",
    "modular agent and cybersecurity cells",
    "premium spatial precision"
  ]
}
