{
  "schema": "szl.hf-static-publication/v1",
  "target": {
    "repo_id": "SZLHOLDINGS/README",
    "repo_type": "space",
    "live_base_url": "https://szlholdings-readme.static.hf.space"
  },
  "source_repository": "szl-holdings/.github",
  "files": [
    {
      "source": "huggingface/org-card/.gitattributes",
      "destination": ".gitattributes"
    },
    {
      "source": "huggingface/org-card/README.md",
      "destination": "README.md"
    },
    {
      "source": "huggingface/org-card/HONEST_DISCLOSURE.md",
      "destination": "HONEST_DISCLOSURE.md"
    },
    {
      "source": "huggingface/org-card/index.html",
      "destination": "index.html"
    },
    {
      "source": "profile/assets/estate-command-system.svg",
      "destination": "assets/estate-command-system.svg"
    },
    {
      "source": "profile/assets/estate-banner-v2.svg",
      "destination": "assets/estate-banner-v2.svg"
    },
    {
      "source": "profile/assets/hf-portfolio-map.svg",
      "destination": "assets/hf-portfolio-map.svg"
    },
    {
      "source": "profile/assets/hf-card-command.svg",
      "destination": "assets/hf-card-command.svg"
    },
    {
      "source": "profile/assets/hf-card-intelligence.svg",
      "destination": "assets/hf-card-intelligence.svg"
    },
    {
      "source": "profile/assets/hf-card-models.svg",
      "destination": "assets/hf-card-models.svg"
    },
    {
      "source": "profile/assets/hf-card-evidence.svg",
      "destination": "assets/hf-card-evidence.svg"
    },
    {
      "source": "profile/assets/evidence-lattice-v2.webp",
      "destination": "assets/evidence-lattice-v2.webp"
    }
  ],
  "runtime_transforms": {
    "README.md": {
      "mode": "rendered_markdown",
      "required_markers": [
        "Current state",
        "HISTORICAL",
        "SIMULATED",
        "assets/evidence-lattice-v2.webp"
      ]
    },
    "index.html": {
      "mode": "hf_bootstrap_injected"
    }
  },
  "prune": true,
  "allowed_deletions": [],
  "smoke": {
    "path": "/",
    "required_marker": "data-szl-surface=\"company-front-door\""
  }
}
