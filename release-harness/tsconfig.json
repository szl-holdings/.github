{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "esModuleInterop": true
  },
  "include": [
    "global-setup.ts",
    "playwright.config.ts",
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
